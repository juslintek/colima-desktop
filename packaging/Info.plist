<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Partial Info.plist used as the base while GENERATE_INFOPLIST_FILE=YES merges the
      standard/auto keys (versions, category, etc.) on top. Holds Sparkle keys that
      Xcode's INFOPLIST_KEY_* mechanism does NOT inject (arbitrary custom keys).

      SUPublicEDKey: the REAL production Ed25519 public key used by Sparkle to verify
                     auto-update signatures. Committing the PUBLIC key is safe and
                     required; it is NOT a placeholder. Its matching PRIVATE key is never
                     committed — it lives in the macOS login keychain (generic password
                     "Private key for signing Sparkle updates", account "ed25519", service
                     "https://sparkle-project.org") and, for CI, in the SPARKLE_PRIVATE_KEY
                     repo secret (which MUST be the export of that same private key so the
                     appcast signatures verify against this public key). See SIGNING.md to
                     enable signing or rotate the key.
      SUFeedURL:     where appcast.xml is hosted.
    -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/juslintek/colima-desktop/main/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>s9mMrmm8Gydc6gn5JWOY2586TROs/PTaM6wm71s5Wcc=</string>
    <key>SUEnableInstallerLauncherService</key>
    <false/>
</dict>
</plist>
